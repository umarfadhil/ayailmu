# Preparation only; this does not enable real users, deploy services or create credentials.
# Supply an approved restricted runtime connection through the host's private secret mechanism.
UMAR_DATABASE_URL=
UMAR_MIGRATE_ON_START=false
UMAR_LISTEN=127.0.0.1:8187
UMAR_AUTH_PROVIDER=gotrue
UMAR_PUBLIC_ORIGIN=https://replace-with-approved-test-origin.invalid
UMAR_OIDC_ISSUER=https://replace-with-approved-test-origin.invalid
# Issuer is public; JWKS transport stays on the private Mac loopback route.
UMAR_OIDC_JWKS_URL=http://127.0.0.1:8287/.well-known/jwks.json
