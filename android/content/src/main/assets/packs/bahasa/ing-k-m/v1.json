  "screens": [
    {
      "screen_id": "ING-K-M-01-S1",
      "unit": "01",
      "audience": "kids",
      "title": {
        "id": "Hariku",
        "en": "My day"
      },
      "body": [
        {
          "id": "Setiap hari: I wake up, I brush my teeth.",
          "en": "Every day: I wake up, I brush my teeth."
        },
        {
          "id": "Jam berapa? It's seven o'clock.",
          "en": "What time is it? It's seven o'clock."
        },
        {
          "id": "Untuk he atau she, tambah -s: She wakes up.",
          "en": "With he or she, add -s: She wakes up."
        }
      ],
      "examples": [
        {
          "target_text": "I wake up at six o'clock.",
          "gloss": {
            "id": "Aku bangun jam enam.",
            "en": "at + a time"
          }
        },
        {
          "target_text": "It's half past seven.",
          "gloss": {
            "id": "Jam setengah delapan (7.30).",
            "en": "half past = 30 minutes after"
          }
        },
        {
          "target_text": "She brushes her teeth.",
          "gloss": {
            "id": "Dia menggosok gigi.",
            "en": "brush → brushes"
          }
        }
      ],
      "review_status": "draft"
    },
    {
      "screen_id": "ING-K-M-02-S1",
      "unit": "02",
      "audience": "kids",
      "title": {
        "id": "Cuaca & pakaian",
        "en": "Weather & clothes"
      },
      "body": [
        {
          "id": "Cuacanya? It's sunny. It's rainy.",
          "en": "What's the weather like? It's sunny. It's rainy."
        },
        {
          "id": "Pakaian: I wear a shirt and pants.",
          "en": "Clothes: I wear a shirt and pants."
        },
        {
          "id": "Indonesia punya dua musim: hujan dan kemarau.",
          "en": "Indonesia has two seasons: the rainy season and the dry season."
        }
      ],
      "examples": [
        {
          "target_text": "It's windy today.",
          "gloss": {
            "id": "Hari ini berangin.",
            "en": "windy = lots of wind"
          }
        },
        {
          "target_text": "I wear a jacket when it's cold.",
          "gloss": {
            "id": "Aku memakai jaket kalau dingin.",
            "en": "wear = memakai"
          }
        },
        {
          "target_text": "spring, summer, fall, winter",
          "gloss": {
            "id": "musim semi, panas, gugur, dingin",
            "en": "four seasons in some countries"
          }
        }
      ],
      "review_status": "draft"
    }
  ],
