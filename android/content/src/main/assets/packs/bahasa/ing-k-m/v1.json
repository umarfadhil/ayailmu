        "en": "Dino's day"
      },
      "target_text": "Dino wakes up at six o'clock.\nHe eats breakfast at half past six.\nHe goes to school at seven o'clock.",
      "body": [
        {
          "id": "Dino bercerita tentang paginya.",
          "en": "Dino tells us about his morning."
        }
      ],
