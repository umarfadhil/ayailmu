  "screens": [
    {
      "screen_id": "ING-A-X-01-S1",
      "unit": "01",
      "audience": "adults",
      "title": {
        "id": "Pendapat & nuansa",
        "en": "Opinions & nuance"
      },
      "body": [
        {
          "id": "Pendapat: I think…, In my opinion…, I'm not sure.",
          "en": "Opinions: I think…, In my opinion…, I'm not sure."
        },
        {
          "id": "Setuju: I agree, bukan I am agree.",
          "en": "To agree, say I agree, not I am agree."
        },
        {
          "id": "Melunakkan: might, probably, seems, a bit.",
          "en": "Softening: might, probably, seems, a bit."
        }
      ],
      "examples": [
        {
          "target_text": "I see your point, but I'm not sure.",
          "gloss": {
            "id": "Saya paham maksud Anda, tapi saya ragu.",
            "en": "polite disagreement"
          }
        },
        {
          "target_text": "It might rain later.",
          "gloss": {
            "id": "Mungkin nanti hujan.",
            "en": "might = maybe, not certain"
          }
        },
        {
          "target_text": "Actually, I prefer tea.",
          "gloss": {
            "id": "Sebenarnya saya lebih suka teh.",
            "en": "actually = sebenarnya, not aktual"
          }
        },
        {
          "target_text": "The price seems a bit high.",
          "gloss": {
            "id": "Harganya agak mahal, sepertinya.",
            "en": "softer than: too expensive"
          }
        }
      ],
      "review_status": "draft"
    },
    {
      "screen_id": "ING-A-X-02-S1",
      "unit": "02",
      "audience": "adults",
      "title": {
        "id": "Email & permintaan sopan",
        "en": "Emails & polite requests"
      },
      "body": [
        {
          "id": "Permintaan sopan: Could you…? Would you mind…ing?",
          "en": "Polite requests: Could you…? Would you mind…ing?"
        },
        {
          "id": "Email kerja: sapaan, tujuan, permintaan, penutup.",
          "en": "Work emails: greeting, purpose, request, closing."
        },
        {
          "id": "Ke atasan lebih formal daripada ke teman.",
          "en": "To a manager, be more formal than to a friend."
        }
      ],
      "examples": [
        {
          "target_text": "Could you send me the report by Friday?",
          "gloss": {
            "id": "Bisa kirimkan laporannya paling lambat Jumat?",
            "en": "a polite request"
          }
        },
        {
          "target_text": "Would you mind closing the door?",
          "gloss": {
            "id": "Boleh tolong tutup pintunya?",
            "en": "would you mind + -ing"
          }
        },
        {
          "target_text": "I'm writing to ask about…",
          "gloss": {
            "id": "Saya menulis untuk menanyakan…",
            "en": "the purpose of an email"
          }
        },
        {
          "target_text": "Best regards,",
          "gloss": {
            "id": "Salam,",
            "en": "a common closing"
          }
        }
      ],
      "review_status": "draft"
    }
  ],
