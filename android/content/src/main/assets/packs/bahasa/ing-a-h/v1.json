        "en": "Travel"
      },
      "body": [
        {
          "id": "Di bandara dan hotel: check in, check out.",
          "en": "At the airport and hotel: check in, check out."
        },
        {
          "id": "Bertanya sopan: Could you tell me where the gate is?",
          "en": "Ask politely: Could you tell me where the gate is?"
        },
        {
          "id": "Perhatikan: where the gate is, bukan where is the gate.",
          "en": "Note the order: where the gate is, not where is the gate."
        }
      ],
      "examples": [
        {
          "target_text": "I'd like to check in, please.",
          "gloss": {
            "id": "Saya mau check-in.",
            "en": "at a hotel or airport desk"
          }
        },
        {
          "target_text": "Could you tell me where the bank is?",
          "gloss": {
            "id": "Boleh tahu bank di mana?",
            "en": "polite: the verb goes last"
          }
        },
        {
          "target_text": "Get off at the next stop.",
          "gloss": {
            "id": "Turun di halte berikutnya.",
            "en": "get on / get off a bus or train"
          }
        },
        {
          "target_text": "Go past the bank.",
          "gloss": {
            "id": "Lewati bank.",
            "en": "go past = walk by it"
          }
        }
      ],
      "review_status": "draft"
    },
    {
      "screen_id": "ING-A-H-02-S1",
      "unit": "02",
      "audience": "adults",
      "title": {
