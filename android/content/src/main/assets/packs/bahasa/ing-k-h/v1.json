  "screens": [
    {
      "screen_id": "ING-K-H-01-S1",
      "unit": "01",
      "audience": "kids",
      "title": {
        "id": "Di kota",
        "en": "In town"
      },
      "body": [
        {
          "id": "Tempat di kota: bank, library, post office.",
          "en": "Places in town: bank, library, post office."
        },
        {
          "id": "Arah: turn left, turn right, go straight.",
          "en": "Directions: turn left, turn right, go straight."
        },
        {
          "id": "Letak: next to, between, across from.",
          "en": "Where things are: next to, between, across from."
        }
      ],
      "examples": [
        {
          "target_text": "Where is the library?",
          "gloss": {
            "id": "Perpustakaan di mana?",
            "en": "asking the way"
          }
        },
        {
          "target_text": "It's next to the bank.",
          "gloss": {
            "id": "Di sebelah bank.",
            "en": "next to = beside"
          }
        },
        {
          "target_text": "It's between the bank and the park.",
          "gloss": {
            "id": "Di antara bank dan taman.",
            "en": "between = in the middle"
          }
        },
        {
          "target_text": "It's across from the park.",
          "gloss": {
            "id": "Di seberang taman.",
            "en": "across from = on the other side"
          }
        }
      ],
      "review_status": "draft"
    },
    {
      "screen_id": "ING-K-H-02-S1",
      "unit": "02",
      "audience": "kids",
      "title": {
        "id": "Pekerjaan & kemarin",
        "en": "Jobs & yesterday"
      },
      "body": [
        {
          "id": "Pekerjaan: farmer, chef, nurse, pilot.",
          "en": "Jobs: farmer, chef, nurse, pilot."
        },
        {
          "id": "Kemarin: tambah -ed. Play → played.",
          "en": "Yesterday: add -ed. Play → played."
        },
        {
          "id": "Ada yang berubah: go → went, eat → ate.",
          "en": "Some words change: go → went, eat → ate."
        }
      ],
      "examples": [
        {
          "target_text": "She is a nurse. She helps sick people.",
          "gloss": {
            "id": "Dia perawat. Dia menolong orang sakit.",
            "en": "a job and what it does"
          }
        },
        {
          "target_text": "Yesterday I visited my grandma.",
          "gloss": {
            "id": "Kemarin aku mengunjungi nenek.",
            "en": "visit → visited"
          }
        },
        {
          "target_text": "We went to the beach.",
          "gloss": {
            "id": "Kami pergi ke pantai.",
            "en": "go → went"
          }
        },
        {
          "target_text": "I saw a big ship.",
          "gloss": {
            "id": "Aku melihat kapal besar.",
            "en": "see → saw"
          }
        }
      ],
      "review_status": "draft"
    }
  ],
  "readings": {
