      "title": {
        "id": "Pesan dari Tom",
        "en": "A note from Tom"
      },
      "target_text": "Hi Sari! Come to my house on Saturday.\nGo straight and turn right at the traffic light.\nMy house is next to the library, across from the park.",
      "body": [
        {
          "id": "Tom memberi petunjuk jalan ke rumahnya.",
          "en": "Tom gives directions to his house."
        }
      ],
      "review_status": "draft"
    },
    "R-INGKH-02": {
      "title": {
        "id": "Sabtu Dani",
        "en": "Dani's Saturday"
      },
      "target_text": "Last Saturday, Dani rode his bicycle to his uncle's house.\nHis uncle is a farmer.\nThey walked to the rice field and watched the ducks.\nThen they ate fried bananas.",
      "body": [
        {
          "id": "Dani bercerita tentang hari Sabtunya.",
          "en": "Dani tells us about his Saturday."
        }
      ],
      "review_status": "draft"
    }
  },
