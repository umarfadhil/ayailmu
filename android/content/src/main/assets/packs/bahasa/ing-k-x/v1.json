      "screen_id": "ING-K-X-01-S1",
      "unit": "01",
      "audience": "kids",
      "title": {
        "id": "Cerita & perasaan",
        "en": "Stories & feelings"
      },
      "body": [
        {
          "id": "Perasaan baru: excited, nervous, proud, angry, calm.",
          "en": "New feelings: excited, nervous, proud, angry, calm."
        },
        {
          "id": "Bored = merasa bosan. Boring = membosankan.",
          "en": "Bored is how you feel; boring is the thing."
        },
        {
          "id": "Cerita memakai: then, but, because, so.",
          "en": "Stories use: then, but, because, so."
        }
      ],
      "examples": [
        {
          "target_text": "I'm excited about the trip!",
          "gloss": {
            "id": "Aku tidak sabar ikut jalan-jalan!",
            "en": "excited = very happy about something soon"
          }
        },
        {
          "target_text": "The movie was boring, so I was bored.",
          "gloss": {
            "id": "Filmnya membosankan, jadi aku bosan.",
            "en": "-ing thing, -ed feeling"
          }
        },
        {
          "target_text": "She was nervous because she had a test.",
          "gloss": {
            "id": "Dia gugup karena ada ulangan.",
            "en": "because = karena"
          }
        },
        {
          "target_text": "He felt proud.",
          "gloss": {
            "id": "Dia merasa bangga.",
            "en": "proud = bangga"
          }
        }
      ],
      "review_status": "draft"
    },
    {
      "screen_id": "ING-K-X-02-S1",
      "unit": "02",
      "audience": "kids",
      "title": {
        "id": "Membandingkan",
        "en": "Describing & comparing"
      },
      "body": [
        {
          "id": "Dua benda: bigger than, faster than.",
          "en": "Two things: bigger than, faster than."
        },
        {
          "id": "Paling: the biggest, the fastest.",
          "en": "The most: the biggest, the fastest."
        },
        {
          "id": "Kata baru: un + happy, color + ful.",
          "en": "New words: un + happy, color + ful."
        }
      ],
      "examples": [
        {
          "target_text": "An elephant is bigger than a horse.",
          "gloss": {
            "id": "Gajah lebih besar daripada kuda.",
            "en": "-er + than"
          }
        },
        {
          "target_text": "A turtle is slower than a rabbit.",
          "gloss": {
            "id": "Kura-kura lebih lambat daripada kelinci.",
            "en": "slow → slower"
          }
        },
        {
          "target_text": "good → better → the best",
          "gloss": {
            "id": "baik → lebih baik → terbaik",
            "en": "a word that changes"
          }
        },
        {
          "target_text": "unhappy, colorful, helpful",
          "gloss": {
            "id": "tidak bahagia, berwarna-warni, suka menolong",
            "en": "un- = not, -ful = full of"
          }
        }
      ],
      "review_status": "draft"
    }
  ],
