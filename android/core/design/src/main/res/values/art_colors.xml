  Starting values: the illustrator's style bible replaces the hex codes, not the roles.
  Keep in sync with LIGHT in art/tools/draw.py (used for the SVG previews and contact sheets).
-->
<resources>
  <color name="art_paper">#F6F1E7</color>
  <color name="art_ink">#2B2A28</color>
  <color name="art_clay">#C4613A</color>
  <color name="art_ochre">#D9A441</color>
  <color name="art_sage">#8A9A77</color>
  <color name="art_slate">#5B6B80</color>
  <color name="art_blush">#E3A99A</color>
</resources>
