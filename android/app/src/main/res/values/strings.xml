    <!-- Trial consent (Arabic, evidence track). DRAFT: review against UU PDP (UU No. 27/2022) before the closed test. -->
    <string name="consent_title">Sebelum mulai: persetujuan uji coba</string>
    <string name="consent_intro">Kursus Bahasa Arab di AyaIlmu sedang diuji coba. Bacalah ini dulu; hanya butuh satu menit.</string>
    <string name="consent_what_title">Apa yang disimpan</string>
    <string name="consent_what_body">Jawabanmu, kapan dan berapa lama kamu menjawab, dan hasil latihan, dengan ID pelajar acak. Tidak ada nama asli, email, nomor HP, kontak, atau lokasi.</string>
    <string name="consent_where_title">Di mana disimpan dan siapa yang melihat</string>
    <string name="consent_where_body">Semuanya tersimpan di HP ini saja. Tim kursus AyaIlmu (PT Petalytix Teknologi Indonesia) hanya melihat jawabanmu jika kamu sendiri mengirim file ekspor dari Pengaturan.</string>
    <string name="consent_why_title">Untuk apa</string>
    <string name="consent_why_body">Untuk memeriksa apakah pelajaran dan soal bekerja, lalu memperbaikinya. Bukan untuk iklan, dan tidak dijual atau dibagikan ke pihak lain.</string>
    <string name="consent_keep_title">Berapa lama disimpan</string>
    <string name="consent_keep_body">Di HP ini: sampai kamu menghapusnya. File yang kamu kirim ke tim: dihapus paling lambat 6 bulan setelah uji coba berakhir.</string>
    <string name="consent_stop_title">Berhenti dan menghapus</string>
    <string name="consent_stop_body">Kamu boleh berhenti kapan saja tanpa alasan. Hapus data di HP lewat Pengaturan. Untuk menghapus file yang sudah kamu kirim, email %1$s dan sebutkan ID pelajarmu (ada di Pengaturan).</string>
    <string name="consent_too_young">Uji coba ini khusus untuk usia 18 tahun ke atas, jadi profil ini belum bisa ikut. Pelajaran lain tetap bisa dipakai.</string>
    <string name="consent_check_adult">Saya berusia 18 tahun atau lebih.</string>
    <string name="consent_check_agree">Saya setuju jawaban saya disimpan seperti dijelaskan di atas.</string>
    <string name="consent_accept">Setuju dan lanjut</string>
    <string name="consent_error">Persetujuan belum tersimpan. Coba lagi.</string>
    <string name="consent_version_note">Versi teks: %1$s</string>

