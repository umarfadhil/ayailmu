    <!-- Trial consent (Arabic, evidence track). DRAFT: review against UU PDP (UU No. 27/2022) before the closed test. -->
    <string name="consent_title">Before you start: trial consent</string>
    <string name="consent_intro">The Arabic course in AyaIlmu is in a trial. Please read this first; it takes a minute.</string>
    <string name="consent_what_title">What is stored</string>
    <string name="consent_what_body">Your answers, when and how long you took to answer, and practice results, under a random learner ID. No real name, email, phone number, contacts or location.</string>
    <string name="consent_where_title">Where it is kept and who sees it</string>
    <string name="consent_where_body">Everything stays on this phone. The AyaIlmu course team (PT Petalytix Teknologi Indonesia) only sees your answers if you send them the export file from Settings yourself.</string>
    <string name="consent_why_title">What it is for</string>
    <string name="consent_why_body">To check whether the lessons and questions work, and to improve them. Never for ads, and never sold or shared with anyone else.</string>
    <string name="consent_keep_title">How long it is kept</string>
    <string name="consent_keep_body">On this phone: until you delete it. Files you send to the team: deleted no later than 6 months after the trial ends.</string>
    <string name="consent_stop_title">Stopping and deleting</string>
    <string name="consent_stop_body">You can stop at any time, no reason needed. Delete the data on this phone in Settings. To delete files you already sent, email %1$s with your learner ID (shown in Settings).</string>
    <string name="consent_too_young">This trial is for people aged 18 and over, so this profile can\'t join it. Other subjects are still open.</string>
    <string name="consent_check_adult">I am 18 or older.</string>
    <string name="consent_check_agree">I agree to my answers being stored as described above.</string>
    <string name="consent_accept">Agree and continue</string>
    <string name="consent_error">The consent wasn\'t saved. Please try again.</string>
    <string name="consent_version_note">Text version: %1$s</string>

