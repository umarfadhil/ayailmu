<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: Aya waving in front of an ochre sun on paper (art_app_icon via ic_launcher_foreground), with a
     one-colour layer for Android 13+ themed icons (art_app_icon_mono via ic_launcher_monochrome). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/aya_paper" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
