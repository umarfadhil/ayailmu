<?xml version="1.0" encoding="utf-8"?>
<!-- DRAFT launcher icon: Aya on paper (art_app_icon_draft via ic_launcher_foreground), with a draft one-colour
     layer for Android 13+ themed icons (art_app_icon_mono via ic_launcher_monochrome). Both are replaced when the
     illustrator delivers the icon (art/briefs). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/aya_paper" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
