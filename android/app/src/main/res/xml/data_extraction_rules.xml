<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules (CR-DAT-6): these device backups are separate from optional account sync.
     Databases and DataStore are included; no-backup credentials, deletion proofs and caches are not. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
