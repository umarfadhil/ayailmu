<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 11 and below (mirrors data_extraction_rules.xml). -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="datastore/" />
    <!-- The include allowlist already excludes every other file path, including caches. -->
</full-backup-content>
