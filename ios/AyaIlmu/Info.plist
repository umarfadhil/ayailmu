<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AyaIlmuApprovedOrigin</key>
	<string>$(AYAILMU_RELEASE_APPROVED_ORIGIN)</string>
	<key>AyaIlmuDeclarationVersion</key>
	<string>$(AYAILMU_DECLARATION_VERSION)</string>
	<key>AyaIlmuOrigin</key>
	<string>$(AYAILMU_ORIGIN)</string>
