/* Messages from the account service layer */
"Account operation cancelled." = "Dibatalkan.";
"Signed out." = "Kamu sudah keluar.";
"Signed out on this device. The server could not confirm session revocation." = "Kamu sudah keluar di perangkat ini, tetapi server belum memastikannya.";
"Local sign-out could not be saved. Please retry." = "Belum berhasil keluar. Coba lagi.";
"Sign in again with your password." = "Masuk lagi dengan kata sandimu.";
"Offline. Showing saved progress on this device." = "Kamu sedang offline. Ini kemajuan yang tersimpan di perangkat ini.";
"The account service took too long to respond. Please try again." = "Layanan akun terlalu lama merespons. Coba lagi.";
"A secure connection to the account service could not be established. Please try again." = "Sambungan aman ke layanan akun belum berhasil. Coba lagi.";
"Cannot connect to the account service. Check your connection and try again." = "Tidak bisa terhubung. Periksa koneksimu, lalu coba lagi.";
"Too many attempts. Please wait before trying again." = "Terlalu banyak percobaan. Tunggu sebentar, lalu coba lagi.";
"Confirm your email before signing in." = "Konfirmasi emailmu dulu sebelum masuk.";
"The credentials or code were not accepted. Please check them and try again." = "Email, kata sandi, atau kodenya tidak cocok. Coba periksa lagi.";
"The account service could not complete this request. Please try again." = "Belum berhasil. Coba lagi sebentar lagi.";
"The account service response could not be accepted. Please try again." = "Belum berhasil. Coba lagi sebentar lagi.";
"Your account could not be verified. Sign in again." = "Akunmu belum bisa dipastikan. Masuk lagi.";
"Secure storage failed. Please try again." = "Penyimpanan aman bermasalah. Coba lagi.";
"Enter a valid email, a password of 12–256 characters, and a six-digit code where requested. Confirm the adult or guardian declaration to continue." = "Periksa email, kata sandi (12–256 karakter), dan kode 6 digit jika diminta, lalu centang pernyataan dewasa atau wali.";

/* Signed-in account area */
"Account" = "Akun";
"Signed in as %@" = "Masuk sebagai %@";
"Saved account: %@" = "Akun tersimpan: %@";
"Reconnect" = "Sambungkan lagi";
"Sign in again with password" = "Masuk lagi dengan kata sandi";
"Sign out" = "Keluar";
"Cancel" = "Batal";
"Delete entire account" = "Hapus akun";
"Permanently delete this entire account?" = "Hapus akun ini secara permanen?";
"Delete my account" = "Hapus akun saya";
"Removes your account and its data from our servers. Learning on this device stays." = "Menghapus akun dan datanya dari server kami. Pelajaran di perangkat ini tetap ada.";
"This deletes your account and everything stored for it on our servers: all profiles, including child profiles, synced answers and consent records. It can’t be undone, and closing this screen won’t cancel it. Removing the sign-in itself can take a little longer.\n\nLessons already on this device stay here but will no longer sync; signing out or switching accounts closes access to them. We keep a minimal record of the deletion, and backups are cleared on their own schedule. You may be asked to sign in again to confirm." = "Akunmu dan semua yang tersimpan untuknya di server kami akan dihapus: semua profil, termasuk profil anak, jawaban yang tersinkron, dan catatan persetujuan. Ini tidak bisa dibatalkan, dan menutup layar ini tidak menghentikannya. Penghapusan akun masuknya sendiri bisa sedikit lebih lama.\n\nPelajaran yang sudah ada di perangkat ini tetap ada tetapi tidak lagi disinkronkan; keluar atau berganti akun menutup akses ke sana. Kami menyimpan catatan kecil tentang penghapusan ini, dan cadangan server terhapus sesuai jadwalnya. Kamu mungkin diminta masuk lagi untuk memastikan.";

/* Deletion follow-up */
"Account deletion" = "Penghapusan akun";
"Try again" = "Coba lagi";
"Check deletion status" = "Cek status penghapusan";
"Checking account deletion…" = "Mengecek penghapusan akun…";
"Done: your data and sign-in account are deleted." = "Selesai: data dan akun masukmu sudah dihapus.";
"Your data is deleted. The sign-in account is still being removed." = "Datamu sudah dihapus. Akun masuknya masih dalam proses.";
"Deletion isn’t confirmed yet. Your request is saved." = "Penghapusan belum terkonfirmasi. Permintaanmu tersimpan.";
"You can check the status without signing in. Keep this app installed on this device until deletion finishes; the record that proves your request is stored only here." = "Kamu bisa mengecek status tanpa masuk. Biarkan aplikasi ini terpasang di perangkat ini sampai penghapusan selesai; bukti permintaanmu hanya tersimpan di sini.";

