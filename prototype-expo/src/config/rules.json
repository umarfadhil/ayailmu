{
  "rules_version": "pilot-0.3-local",
  "mode": "developer-demo",
  "audio_enabled": false,
  "typo_tolerance": { "min_word_length": 5, "max_edits": 1 },
  "review_spacing_days": [1, 3, 7],
  "review_share_max": 0.5,
  "max_step_active_minutes": 10,
  "binary_streak": 4,
  "binary_min_days": 2,
  "tile_counts_as_free": false,
  "session_minutes_options": [10, 15, 20],
  "default_session_minutes": 15,
  "ready_after_practice_attempts": 3,
  "check_days": { "D7": 7, "D30": 30 },
  "checks_per_skill_min": 2,
  "checks_per_skill_max": 3,
  "recognition_counts_as_free": false,
  "learned_rule": "pending",
  "unit_order": ["A", "B"],
  "unit_start_rule": "previous-unit-core-screens-and-practice-attempted",
  "negation_words": ["tidak", "belum", "bukan", "tak"],
  "possession_words": ["milik", "miliknya", "punya", "mempunyai", "memiliki", "kepunyaan"],
  "action_words": ["berkata", "mengatakan", "bilang", "berucap", "berbicara", "bicara"]
}
