{
  "name": "arabic-trial-app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/noto-naskh-arabic": "^0.4.5",
    "@expo-google-fonts/plus-jakarta-sans": "0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/auth-js": "2.118.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "EXPO_PUBLIC_APP_MODE=developer-demo expo start --clear",
    "android": "EXPO_PUBLIC_APP_MODE=developer-demo expo start --android --clear",
    "ios": "EXPO_PUBLIC_APP_MODE=developer-demo expo start --ios --clear",
    "web": "EXPO_PUBLIC_APP_MODE=developer-demo expo start --web --localhost --port 8081 --clear",
    "web:dev": "EXPO_PUBLIC_APP_MODE=developer-demo expo start --web --localhost --port 8081 --clear",
    "web:tester": "EXPO_PUBLIC_APP_MODE=tester expo start --web --localhost --port 8082 --clear",
    "export:dev": "EXPO_PUBLIC_APP_MODE=developer-demo expo export --platform all --clear --output-dir dist/developer-demo",
    "export:tester": "EXPO_PUBLIC_APP_MODE=tester expo export --platform all --clear --output-dir dist/tester",
    "test": "TZ=Asia/Jakarta jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test/sdk58AssetRegistry.cjs"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
