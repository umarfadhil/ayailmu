{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "developer-preview": {
      "distribution": "internal",
      "node": "22.16.0",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_APP_MODE": "developer-demo",
        "EXPO_PUBLIC_AUTH_PROVIDER": "off",
        "EXPO_PUBLIC_PRODUCTION_ACCOUNTS": "off",
        "EXPO_NO_DOTENV": "1",
        "EXPO_NO_TELEMETRY": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "staging-tester": {
      "distribution": "internal",
      "node": "22.16.0",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_APP_MODE": "tester",
        "EXPO_PUBLIC_ACCOUNT_ENV": "staging",
        "EXPO_PUBLIC_AUTH_PROVIDER": "off",
        "EXPO_PUBLIC_PRODUCTION_ACCOUNTS": "off",
        "EXPO_NO_DOTENV": "1",
        "EXPO_NO_TELEMETRY": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "node": "22.16.0",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_APP_MODE": "tester",
        "EXPO_PUBLIC_ACCOUNT_ENV": "production",
        "EXPO_PUBLIC_AUTH_PROVIDER": "off",
        "EXPO_PUBLIC_PRODUCTION_ACCOUNTS": "off",
        "EXPO_NO_DOTENV": "1",
        "EXPO_NO_TELEMETRY": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
