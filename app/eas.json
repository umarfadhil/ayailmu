{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "developer-preview": {
      "distribution": "internal",
      "node": "22.16.0",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_APP_MODE": "developer-demo",
        "EXPO_PUBLIC_AUTH_PROVIDER": "off",
        "EXPO_PUBLIC_PRODUCTION_ACCOUNTS": "off",
        "EXPO_NO_DOTENV": "1",
        "EXPO_NO_TELEMETRY": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "staging-tester": {
      "distribution": "internal",
      "node": "22.16.0",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_APP_MODE": "tester",
        "EXPO_PUBLIC_ACCOUNT_ENV": "staging",
        "EXPO_PUBLIC_AUTH_PROVIDER": "off",
        "EXPO_PUBLIC_PRODUCTION_ACCOUNTS": "off",
        "EXPO_NO_DOTENV": "1",
        "EXPO_NO_TELEMETRY": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "private-beta": {
      "distribution": "store",
      "node": "22.16.0",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_PRIVATE_BETA": "on",
        "EXPO_PUBLIC_APP_MODE": "tester",
        "EXPO_PUBLIC_ACCOUNT_ENV": "staging",
        "EXPO_PUBLIC_AUTH_PROVIDER": "local-supabase",
        "EXPO_PUBLIC_PRODUCTION_ACCOUNTS": "off",
        "EXPO_PUBLIC_PRIVATE_QA": "off",
        "EXPO_PUBLIC_ACCOUNT_REGISTRATION": "off",
        "EXPO_PUBLIC_GOOGLE_SIGN_IN": "off",
        "EXPO_PUBLIC_PASSWORD_RECOVERY": "off",
        "EXPO_NO_DOTENV": "1",
        "EXPO_NO_TELEMETRY": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "learning-beta": {
      "distribution": "store",
      "node": "22.16.0",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_LEARNING_BETA": "on",
        "EXPO_PUBLIC_APP_MODE": "tester",
        "EXPO_PUBLIC_ACCOUNT_ENV": "learning-beta",
        "EXPO_PUBLIC_AUTH_PROVIDER": "local-supabase",
        "EXPO_PUBLIC_PRODUCTION_ACCOUNTS": "off",
        "EXPO_PUBLIC_PRIVATE_QA": "off",
        "EXPO_PUBLIC_PRIVATE_BETA": "off",
        "EXPO_PUBLIC_ACCOUNT_REGISTRATION": "off",
        "EXPO_PUBLIC_GOOGLE_SIGN_IN": "off",
        "EXPO_PUBLIC_PASSWORD_RECOVERY": "off",
        "EXPO_PUBLIC_REMEMBER_DEVICE": "on",
        "EXPO_NO_DOTENV": "1",
        "EXPO_NO_TELEMETRY": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "general-user": {
      "distribution": "internal",
      "node": "22.16.0",
      "autoIncrement": false,
      "env": {
        "AYAFASIH_GENERAL_USER": "on",
        "EXPO_PUBLIC_APP_MODE": "tester",
        "EXPO_PUBLIC_ACCOUNT_ENV": "production",
        "EXPO_PUBLIC_AUTH_PROVIDER": "local-supabase",
        "EXPO_PUBLIC_PRODUCTION_ACCOUNTS": "on",
        "EXPO_PUBLIC_ACCOUNT_REGISTRATION": "confirmed-email",
        "EXPO_PUBLIC_PRIVATE_QA": "off",
        "EXPO_PUBLIC_PRIVATE_BETA": "off",
        "EXPO_PUBLIC_LEARNING_BETA": "off",
        "EXPO_PUBLIC_GOOGLE_SIGN_IN": "off",
        "EXPO_PUBLIC_PASSWORD_RECOVERY": "off",
        "EXPO_PUBLIC_REMEMBER_DEVICE": "on",
        "EXPO_PUBLIC_NORMAL_USER_STARTER": "on",
        "EXPO_NO_DOTENV": "1",
        "EXPO_NO_TELEMETRY": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "node": "22.16.0",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_APP_MODE": "tester",
        "EXPO_PUBLIC_ACCOUNT_ENV": "production",
        "EXPO_PUBLIC_AUTH_PROVIDER": "off",
        "EXPO_PUBLIC_PRODUCTION_ACCOUNTS": "off",
        "EXPO_NO_DOTENV": "1",
        "EXPO_NO_TELEMETRY": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
