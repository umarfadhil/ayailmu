# Explicit native local development. Public build settings and public CA only.
# Nothing is loaded automatically; the native build must apply this profile.
AYAFASIH_GENERAL_USER=off
EXPO_NO_DOTENV=1
EXPO_PUBLIC_APP_MODE=tester
EXPO_PUBLIC_AUTH_PROVIDER=local-supabase
EXPO_PUBLIC_ACCOUNT_ENV=local-development
EXPO_PUBLIC_LOCAL_DEVELOPMENT=on
AYAFASIH_LOCAL_DEVELOPMENT_IOS_BUNDLE_ID=com.example.ayafasih.local
EXPO_PUBLIC_PRODUCTION_ACCOUNTS=off
EXPO_PUBLIC_PRIVATE_QA=off
EXPO_PUBLIC_PRIVATE_BETA=off
EXPO_PUBLIC_LEARNING_BETA=off
EXPO_PUBLIC_ACCOUNT_REGISTRATION=confirmed-email
EXPO_PUBLIC_GOOGLE_SIGN_IN=off
EXPO_PUBLIC_PASSWORD_RECOVERY=off
EXPO_PUBLIC_REMEMBER_DEVICE=on
EXPO_PUBLIC_NORMAL_USER_STARTER=on
EXPO_PUBLIC_API_BASE_URL=https://localhost:58444
EXPO_PUBLIC_SUPABASE_AUTH_URL=https://localhost:58445

# Supply the existing authorized public CA, never a private key.
# The empty example values deliberately refuse to build until configured.
AYA_LOCAL_DEVELOPMENT_CA_PATH=
AYA_LOCAL_DEVELOPMENT_CA_SHA256=
