# INACTIVE example for the general-user profile. It is not loaded automatically and it is not a .env file.
# Only after the operator has approved the two public roots below, copy it by hand to
# profiles/general-user.env.local (git-ignored). See docs/GENERAL_USER_PROFILE.md.
# Public build settings only. Never put an address, account, secret, key, certificate or native identifier here.

AYAFASIH_GENERAL_USER=on
EXPO_NO_DOTENV=1
EXPO_PUBLIC_APP_MODE=tester
EXPO_PUBLIC_AUTH_PROVIDER=local-supabase
EXPO_PUBLIC_ACCOUNT_ENV=production
EXPO_PUBLIC_PRODUCTION_ACCOUNTS=on
EXPO_PUBLIC_ACCOUNT_REGISTRATION=confirmed-email
EXPO_PUBLIC_PRIVATE_QA=off
EXPO_PUBLIC_PRIVATE_BETA=off
EXPO_PUBLIC_LEARNING_BETA=off
EXPO_PUBLIC_GOOGLE_SIGN_IN=off
EXPO_PUBLIC_PASSWORD_RECOVERY=off
EXPO_PUBLIC_REMEMBER_DEVICE=on
EXPO_PUBLIC_NORMAL_USER_STARTER=on

# Operator-supplied and blank here: two distinct, normally trusted public HTTPS root origins.
# Both must be filled with approved values before use; blank values fail the build gate.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_AUTH_URL=
